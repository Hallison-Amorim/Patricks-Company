# ==========================================================
# EMPREST.AI — Modelo de .env do backend (copie para .env)
# Stack alvo: NestJS + Prisma + PostgreSQL (Supabase)
# ==========================================================

# --- Aplicação ---
NODE_ENV=development
PORT=3000
API_PREFIX=api

# --- Banco de dados (Prisma) ---
DATABASE_URL="postgresql://usuario:senha@localhost:5432/emprestai?schema=public"

# --- Autenticação (JWT) ---
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- CORS (origem do front — produção, Vercel) ---
CORS_ORIGIN=https://patricks-company-front.vercel.app

# --- CORS (origem do front — desenvolvimento local) ---
# Descomente para rodar na sua máquina (e comente a de produção acima).
# CORS_ORIGIN=http://localhost:5173

# --- Supabase (auth + storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
